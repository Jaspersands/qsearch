  "status": "generic-direct-qsvt-rescaling-exponential-average-source-structured-routes-open",
  "summary": "Verified 13 all-n lifted source controls with 0 failures. Singleton and doubleton fibers co-occurred in 24/24 finite random controls. Generic direct QSVT rescaling is exponentially degree-limited; the average-source transfer is proved, and no source-structured lower bound is claimed.",
  "theorem": {
    "amplitude_encoding_bound": "For singular values sqrt(c/D), d>=sqrt((1-1/sqrt(2)-2epsilon)*sqrt(D)/(sqrt(2)-1)).",
    "count_encoding_bound": "d>=sqrt((1-1/sqrt(2)-2epsilon)D).",
    "explicit_source_family": "a=(1,1,4,8,...,2^(n-1)) has N/2 singleton, N/4 doubleton, and N/4 empty fibers for every n>=2.",
    "markov_inequality": "For real degree-d p bounded by one on [-1,1], max_{[-1,1]} |p'| <= d^2.",
    "target_weights": "|p(1/D)-1|<=epsilon and |p(2/D)-1/sqrt(2)|<=epsilon."
  }
}