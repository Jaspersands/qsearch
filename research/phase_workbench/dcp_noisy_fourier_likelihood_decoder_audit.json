  "summary_of_theorems": {
    "T1_cnot_tree_merge_visibility_law": "CNOT merge of rho(k_1; s, v_1) and rho(k_2; s, v_2) yields branch b in {0,1} with exact probability 1/2 and normalized state rho(k_1 + (-1)^b k_2 mod N; s, v_1 v_2). A depth-d binary tree produces visibility v_d = (1 - p_bad)^(2^d).",
    "T2_quadrature_orthogonality_and_moments": "Balanced {X, Y} quadrature score S(s') = z phi_A(k s' / N) satisfies E[S(s')] = (v_d / 2) delta_{s, s'}, E[S(s')^2] = 1/2, Var(S(s)) = 1/2 - v_d^2 / 4, and Var(S(s')) = 1/2 (s' != s), breaking the +/-s sign ambiguity of X-only measurement.",
    "T3_raw_copy_sample_efficiency_frontier": "SNR_d(M_raw) / SNR_0(M_raw) = 2^(-d) (1 - p_bad)^(2^(d+1) - 2) <= 2^(-d) < 1 for all d >= 1."
  },
