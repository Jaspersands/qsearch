  "doc_path": "research/DCP_TRUNCATED_QFT_TREE_MERGE_JOINT_CHANNEL_AUDIT.md",
  "summary_of_theorems": {
    "T1_signed_phase_defect_addition": "Under CNOT merge on branch b_br in {0, 1}, the merged phase defect relative to k_out = (k_1 + (-1)^b_br k_2) mod 2^ell is delta_theta_1 + (-1)^b_br delta_theta_2 (mod 2*pi).",
    "T2_branch_symmetry_sine_cancellation_and_depth_d_factorization": "0.5*cos(delta_theta_1 + delta_theta_2) + 0.5*cos(delta_theta_1 - delta_theta_2) = cos(delta_theta_1)*cos(delta_theta_2), so v_{eff, d}^{(b)} = (v_{eff, 0}^{(b)})^(2^d).",
    "T3_joint_cutoff_and_depth_precision_budget": "Whenever Delta_max(ell, b) <= pi/2, v_{eff, d}^{(b)} >= (1 - p_bad)^(2^d) * (cos Delta_max(ell, b))^(2^d) >= (1 - p_bad)^(2^d) * (1 - 2^(d-1) Delta_max(ell, b)^2)."
  },
