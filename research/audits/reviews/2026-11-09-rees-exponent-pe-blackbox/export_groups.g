# Export small p-groups of class < p and exponent > p as permutation groups,
# with a minimal generating set and representatives of all subgroups
# (all subgroups when the group has order <= 625, else conjugacy class reps).
out := OutputTextFile(Concatenation(DIR, "/groups.txt"), false);
SetPrintFormattingStatus(out, false);
emit := function(tag, G, p)
  local iso, P, gens, subs, n, H, cl, e, deg;
  iso := SmallerDegreePermutationRepresentation(Image(IsomorphismPermGroup(G)));
  P := Image(iso);
  deg := LargestMovedPoint(P);
  gens := MinimalGeneratingSet(P);
  if Size(P) <= 625 then subs := List(AllSubgroups(P), H -> GeneratorsOfGroup(H));
  else subs := List(ConjugacyClassesSubgroups(P), cc -> GeneratorsOfGroup(Representative(cc))); fi;
  cl := NilpotencyClassOfGroup(P); e := Exponent(P);
  AppendTo(out, "GROUP ", tag, " ", p, " ", Size(P), " ", cl, " ", e, " ", deg, "\n");
  AppendTo(out, "GENS ", List(gens, g -> ListPerm(g, deg)), "\n");
  for H in subs do AppendTo(out, "SUB ", List(H, g -> ListPerm(g, deg)), "\n"); od;
end;
for spec in [[81,3],[243,3],[625,5],[3125,5]] do
  n := spec[1]; p := spec[2];
  for i in [1..NumberSmallGroups(n)] do
    G := SmallGroup(n, i);
    if NilpotencyClassOfGroup(G) < p and Exponent(G) > p and not IsAbelian(G) then
      if n <= 625 or (i mod 7 = 0 and Exponent(G) <= 125) then
        emit(Concatenation(String(n), "_", String(i)), G, p);
      fi;
    fi;
  od;
od;
# UT_3(Z/9): unitriangular 3x3 over Z/9, generated by elementary matrices.
G := Group([[1,1,0],[0,1,0],[0,0,1]]*ZmodnZObj(1,9), [[1,0,0],[0,1,1],[0,0,1]]*ZmodnZObj(1,9));
emit("UT3_Z9", G, 3);
CloseStream(out);
QUIT;
