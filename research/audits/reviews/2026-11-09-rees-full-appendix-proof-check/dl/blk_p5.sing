// block formulation, 41 generators, char 5, rational-points mode False
LIB "primdec.lib";
ring r = 5, (b11,b12,b13,b14,b21,b22,b23,b24,n11,n12,n21,n22,a11,a12,a13,a14,a21,a22,a23,a24,a31,a32,a33,a34,a41,a42,a43,a44,m11,m12,m21,m22,t,c11,c12,c21,c22), dp;
option(redSB);
ideal I = a11*a22 - a12*a21 - a31*a42 + a32*a41 - m11,
a11*a32 - a12*a31 + a21*a42 - a22*a41 - m21,
a11*a42 - a12*a41 - a21*b22 + a22*b21 - a31*b12 + a32*b11 - n11,
-a11*b12 + a12*b11 + a21*a32 - a22*a31 - a41*b22 + a42*b21 - n21,
a11*a23 - a13*a21 - a31*a43 + a33*a41 - m12,
a11*a33 - a13*a31 + a21*a43 - a23*a41 - m22,
a11*a43 - a13*a41 - a21*b23 + a23*b21 - a31*b13 + a33*b11 - n12,
-a11*b13 + a13*b11 + a21*a33 - a23*a31 - a41*b23 + a43*b21 - n22,
a11*a24 - a14*a21 - a31*a44 + a34*a41,
a11*a34 - a14*a31 + a21*a44 - a24*a41,
a11*a44 - a14*a41 - a21*b24 + a24*b21 - a31*b14 + a34*b11 - c11,
-a11*b14 + a14*b11 + a21*a34 - a24*a31 - a41*b24 + a44*b21 - c21,
a12*a23 - a13*a22 - a32*a43 + a33*a42,
a12*a33 - a13*a32 + a22*a43 - a23*a42,
a12*a43 - a13*a42 - a22*b23 + a23*b22 - a32*b13 + a33*b12 - c12,
-a12*b13 + a13*b12 + a22*a33 - a23*a32 - a42*b23 + a43*b22 - c22,
a12*a24 - a14*a22 - a32*a44 + a34*a42 - m12,
a12*a34 - a14*a32 + a22*a44 - a24*a42 - m22,
a12*a44 - a14*a42 - a22*b24 + a24*b22 - a32*b14 + a34*b12 - n12,
-a12*b14 + a14*b12 + a22*a34 - a24*a32 - a42*b24 + a44*b22 - n22,
a13*a24 - a14*a23 - a33*a44 + a34*a43 + m11,
a13*a34 - a14*a33 + a23*a44 - a24*a43 + m21,
a13*a44 - a14*a43 - a23*b24 + a24*b23 - a33*b14 + a34*b13 + n11,
-a13*b14 + a14*b13 + a23*a34 - a24*a33 - a43*b24 + a44*b23 + n21,
-a21*m21 - a31*m11 + c12,
-a11*m11 - a41*m21 + c22,
-a21*m22 - a31*m12,
-a11*m12 - a41*m22,
-a22*m21 - a32*m11,
-a12*m11 - a42*m21,
-a22*m22 - a32*m12 + c11,
-a12*m12 - a42*m22 + c21,
-a23*m21 - a33*m11 + c11,
-a13*m11 - a43*m21 + c21,
-a23*m22 - a33*m12,
-a13*m12 - a43*m22,
-a24*m21 - a34*m11,
-a14*m11 - a44*m21,
-a24*m22 - a34*m12 + c12,
-a14*m12 - a44*m22 + c22,
a11*a22*a33*a44*t - a11*a22*a34*a43*t - a11*a23*a32*a44*t + a11*a23*a34*a42*t + a11*a24*a32*a43*t - a11*a24*a33*a42*t - a12*a21*a33*a44*t + a12*a21*a34*a43*t + a12*a23*a31*a44*t - a12*a23*a34*a41*t - a12*a24*a31*a43*t + a12*a24*a33*a41*t + a13*a21*a32*a44*t - a13*a21*a34*a42*t - a13*a22*a31*a44*t + a13*a22*a34*a41*t + a13*a24*a31*a42*t - a13*a24*a32*a41*t - a14*a21*a32*a43*t + a14*a21*a33*a42*t + a14*a22*a31*a43*t - a14*a22*a33*a41*t - a14*a23*a31*a42*t + a14*a23*a32*a41*t - 1;
int t0 = rtimer;
ideal J0 = eliminate(I, b11*b12*b13*b14*b21*b22*b23*b24*n11*n12*n21*n22);
ring r0 = 5, (a11,a12,a13,a14,a21,a22,a23,a24,a31,a32,a33,a34,a41,a42,a43,a44,m11,m12,m21,m22,t,c11,c12,c21,c22), dp;
option(redSB);
ideal J0 = std(imap(r,J0));
print("component ideal in (A,M,t,C): dim, vdim, vdim of radical:");
print(dim(J0)); print(vdim(J0)); ideal R0=std(radical(J0)); print(vdim(R0));
ideal J1 = eliminate(R0, a11*a12*a13*a14*a21*a22*a23*a24*a31*a32*a33*a34*a41*a42*a43*a44*m11*m12*m21*m22*t);
ring rc = 5, (c11,c12,c21,c22), dp;
option(redSB);
ideal J1 = std(imap(r0,J1));
print("image on the centre, ideal in c11,c12,c21,c22 (column convention: C e7 = c11 e7 + c21 e8):");
print(J1);
print("dim, vdim, vdim radical:"); print(dim(J1)); print(vdim(J1)); ideal R1=std(radical(J1)); print(vdim(R1));
print("characteristic polynomials / minimal associated primes of the image:");
list L=minAssGTZ(R1); int k; for(k=1;k<=size(L);k++){print(L[k]);}
ring rz = 5, (z,c11,c12,c21,c22), dp;
ideal S = imap(rc,R1) + ideal(c12, c21, c11-z, c22-z);
ideal Jz = eliminate(S, c11*c12*c21*c22);
ring rzz = 5, (z), dp;
ideal Jz = std(imap(rz,Jz));
print("scalar set: ideal in z of central scalars:");
print(Jz); if(size(Jz)>0){print(factorize(Jz[1]));}
ring rt = 5, (x,c11,c12,c21,c22), dp;
ideal T = imap(rc,R1) + ideal(x^2-(c11+c22)*x+(c11*c22-c12*c21));
ideal Jx = eliminate(T, c11*c12*c21*c22);
ring rxx = 5, (x), dp;
ideal Jx = std(imap(rt,Jx));
print("eigenvalue set: ideal in x of all eigenvalues on the centre:");
print(Jx); if(size(Jx)>0){print(factorize(Jx[1]));}
print("seconds:"); print((rtimer-t0));
quit;
