PROGS := [];
PROGS[2] := rec(plus := [[2,1,1/1],[2,2,1/1],[1,3,4],[2,1,-1/1],[2,2,-1/1],[1,6,7],[1,8,1],[1,9,2],[2,10,-1/4],[1,7,6],[1,12,2],[1,13,1],[2,14,1/4],[1,11,15],[1,5,16]], br := [[2,1,-1/1],[2,2,-1/1],[1,3,4],[1,5,1],[1,6,2],[2,7,1/2],[1,4,3],[1,9,2],[1,10,1],[2,11,-1/2],[1,8,12]], bch := [[[1],1/1],[[1,2],1/4],[[2],1/1],[[2,1],-1/4]]);
PROGS[3] := rec(plus := [[2,1,1/1],[2,2,1/1],[1,3,4],[2,1,-1/1],[2,2,-1/1],[1,6,7],[1,8,1],[1,9,2],[2,10,-1/4],[1,7,6],[1,12,2],[1,13,1],[2,14,1/4],[1,11,15],[1,5,16],[2,10,-1/1],[1,18,6],[1,19,10],[1,20,1],[2,21,1/18],[1,18,7],[1,23,10],[1,24,2],[2,25,-1/36],[1,22,26],[2,14,-1/1],[1,28,6],[1,29,14],[1,30,1],[2,31,-1/36],[1,27,32],[1,28,7],[1,34,14],[1,35,2],[2,36,1/18],[1,33,37],[1,17,38]], br := [[2,1,-1/1],[2,2,-1/1],[1,3,4],[1,5,1],[1,6,2],[2,7,1/2],[1,4,3],[1,9,2],[1,10,1],[2,11,-1/2],[1,8,12],[2,7,-1/1],[1,14,3],[1,15,7],[1,16,1],[2,17,-1/3],[1,14,4],[1,19,7],[1,20,2],[2,21,-1/6],[1,18,22],[2,11,-1/1],[1,24,3],[1,25,11],[1,26,1],[2,27,1/6],[1,23,28],[1,24,4],[1,30,11],[1,31,2],[2,32,1/3],[1,29,33],[1,13,34]], bch := [[[1],1/1],[[1,2],1/4],[[1,2,1],-1/18],[[1,2,2],1/36],[[2],1/1],[[2,1],-1/4],[[2,1,1],1/36],[[2,1,2],-1/18]]);
PROGS[4] := rec(plus := [[2,1,1/1],[2,2,1/1],[1,3,4],[2,1,-1/1],[2,2,-1/1],[1,6,7],[1,8,1],[1,9,2],[2,10,-1/4],[1,7,6],[1,12,2],[1,13,1],[2,14,1/4],[1,11,15],[1,5,16],[2,10,-1/1],[1,18,6],[1,19,10],[1,20,1],[2,21,1/18],[1,18,7],[1,23,10],[1,24,2],[2,25,-1/36],[1,22,26],[2,14,-1/1],[1,28,6],[1,29,14],[1,30,1],[2,31,-1/36],[1,27,32],[1,28,7],[1,34,14],[1,35,2],[2,36,1/18],[1,33,37],[1,17,38],[2,21,-1/1],[1,40,6],[1,41,21],[1,42,1],[2,43,-1/32],[2,25,-1/1],[1,45,7],[1,46,25],[1,47,2],[2,48,1/96],[1,44,49],[2,31,-1/1],[1,51,6],[1,52,31],[1,53,1],[2,54,1/96],[1,50,55],[2,36,-1/1],[1,57,7],[1,58,36],[1,59,2],[2,60,-1/32],[1,56,61],[1,39,62]], br := [[2,1,-1/1],[2,2,-1/1],[1,3,4],[1,5,1],[1,6,2],[2,7,1/2],[1,4,3],[1,9,2],[1,10,1],[2,11,-1/2],[1,8,12],[2,7,-1/1],[1,14,3],[1,15,7],[1,16,1],[2,17,-1/3],[1,14,4],[1,19,7],[1,20,2],[2,21,-1/6],[1,18,22],[2,11,-1/1],[1,24,3],[1,25,11],[1,26,1],[2,27,1/6],[1,23,28],[1,24,4],[1,30,11],[1,31,2],[2,32,1/3],[1,29,33],[1,13,34],[2,17,-1/1],[1,36,3],[1,37,17],[1,38,1],[2,39,1/4],[1,36,4],[1,41,17],[1,42,2],[2,43,1/8],[1,40,44],[2,21,-1/1],[1,46,4],[1,47,21],[1,48,2],[2,49,1/12],[1,45,50],[2,27,-1/1],[1,52,3],[1,53,27],[1,54,1],[2,55,-1/12],[1,51,56],[2,32,-1/1],[1,58,3],[1,59,32],[1,60,1],[2,61,-1/8],[1,57,62],[1,58,4],[1,64,32],[1,65,2],[2,66,-1/4],[1,63,67],[1,35,68]], bch := [[[1],1/1],[[1,2],1/4],[[1,2,1],-1/18],[[1,2,1,2],-1/48],[[1,2,2],1/36],[[2],1/1],[[2,1],-1/4],[[2,1,1],1/36],[[2,1,2],-1/18],[[2,1,2,1],1/48]]);

EvalProg := function(x, y, prog, M)
  local v, ins;
  v := [x, y];
  for ins in prog do
    if ins[1] = 1 then Add(v, v[ins[2]] * v[ins[3]]);
    else Add(v, v[ins[2]] ^ (ins[3] mod M)); fi;
  od;
  return v[Length(v)];
end;

TestGroup := function(G, cw, ntr)
  local M, P, Plus, Br, Scal, LBr, BCHg, x, y, z, i, bad, e, nam;
  M := Exponent(G); P := PROGS[cw];
  Plus := function(a, b) return EvalProg(a, b, P.plus, M); end;
  Br := function(a, b) return EvalProg(a, b, P.br, M); end;
  Scal := function(r, a) return a ^ (r mod M); end;
  LBr := function(w, a, b) local r, j, ab; ab := [a, b]; r := ab[w[1]];
    for j in [2..Length(w)] do r := Br(r, ab[w[j]]); od; return r; end;
  BCHg := function(a, b) local s, t; s := One(a);
    for t in P.bch do s := Plus(s, Scal(t[2], LBr(t[1], a, b))); od; return s; end;
  bad := rec(comm := 0, assoc := 0, zero := 0, neg := 0, mult := 0, bil := 0, alt := 0, jac := 0, bch := 0);
  for i in [1..ntr] do
    x := Random(G); y := Random(G); z := Random(G);
    if Plus(x, y) <> Plus(y, x) then bad.comm := bad.comm + 1; fi;
    if Plus(Plus(x, y), z) <> Plus(x, Plus(y, z)) then bad.assoc := bad.assoc + 1; fi;
    if Plus(x, One(G)) <> x then bad.zero := bad.zero + 1; fi;
    if Plus(x, x^-1) <> One(G) then bad.neg := bad.neg + 1; fi;
    if Plus(x, x) <> x^2 then bad.mult := bad.mult + 1; fi;
    if Br(Plus(x, y), z) <> Plus(Br(x, z), Br(y, z)) then bad.bil := bad.bil + 1; fi;
    if Br(x, x) <> One(G) then bad.alt := bad.alt + 1; fi;
    if Plus(Plus(Br(x, Br(y, z)), Br(y, Br(z, x))), Br(z, Br(x, y))) <> One(G) then bad.jac := bad.jac + 1; fi;
    if BCHg(x, y) <> x * y then bad.bch := bad.bch + 1; fi;
  od;
  return bad;
end;

RunOrder := function(p, n, ntr)
  local k, G, c, e, cw, bad, tot, cnt;
  tot := 0; cnt := 0;
  for k in [1..NrSmallGroups(p^n)] do
    G := SmallGroup(p^n, k);
    c := NilpotencyClassOfGroup(G); e := Exponent(G);
    if c < p and e > p then
      for cw in [Maximum(c, 2)..Minimum(p - 1, 4)] do
        bad := TestGroup(G, cw, ntr);
        cnt := cnt + 1;
        if ForAny(RecNames(bad), r -> bad.(r) > 0) then
          Print("FAIL order ", p, "^", n, " id ", k, " class ", c, " exp ", e, " words c=", cw, " ", bad, "\n");
          tot := tot + 1;
        fi;
      od;
    fi;
  od;
  Print("order ", p, "^", n, ": ", cnt, " (group, word-class) tests, ", tot, " failures\n");
end;

