  "theorems": [
    {
      "id": "T1",
      "name": "Exact Global Sign-Conjugation Invariance (epsilon, sigma) <-> (-epsilon, -sigma)",
      "statement": "For every k-call schedule (epsilon, sigma) and phase vector y in Z_q^D, |Psi_(-epsilon, -sigma)(y)> = conj(|Psi_(epsilon, sigma)(y)>), so P_(-epsilon, -sigma)(x | y) = P_(epsilon, sigma)(x | y) identically for all outcomes x in {0, ..., D-1}."
    },
    {
      "id": "T2",
      "name": "Final-Fourier Reflection sigma_k <-> -sigma_k and Klein Four-Group Schedule Quotient",
      "statement": "Flipping sigma_k -> -sigma_k permutes outcomes by modular negation P_(epsilon, (sigma_(1..k-1), -sigma_k))(x | y) = P_(epsilon, sigma)((-x) mod D | y), so the Klein four-group G_4 = {I, iota_1, iota_2, iota_1*iota_2} partitions the 4^k schedules into 4^(k-1) orbits of size 4 with identical E_(epsilon, sigma) and V_HS(epsilon, sigma)."
    },
