    "T1_banded_dyadic_qft_kernel": "<k | F_{2^ell}^{(b)} | x> = 2^(-ell/2) exp(2*pi*i * Theta_ell^{(b)}(k, x)) with Theta_ell^{(b)}(k, x) = sum_{ell-1-b <= m+j <= ell-1} k_m x_j 2^(m+j-ell).",
    "T2_universal_label_uniformity": "Every singleton cell and every two-point cell produces conditional label probability 2^(-ell) for all k in Z_{2^ell} and all cutoffs b in {0, ..., ell-1}.",
    "T3_joint_channel_quadrature_visibility": "|delta_theta_ell^{(b)}(k; x_0, x_1)| <= Delta_max(ell, b) = pi*((ell-b-2)/2^b + 1/2^(ell-1)), and E[S^{(b)}(s)] = v_eff^{(b)} / 2 with v_eff^{(b)} >= (1 - p_bad) cos(Delta_max(ell, b))."
  },
