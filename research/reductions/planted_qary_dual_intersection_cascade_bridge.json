  "status": "VERIFIED_EXACT_DUAL_INTERSECTION_CASCADE_LAWS",
  "summary": {
    "all_cases_verified": true,
    "case_count": 5,
    "scientific_verdict": "Exhaustive enumeration over (B^perp)^m confirms three exact laws for the dual-intersection cascade B_hat_m(U_perp): (1) |B_hat_m(U_perp)| = q^{n - r_perp(U_perp)} with exact recovery B_hat_m = B iff r_perp = n - d; (2) every non-planted vector x in F_q^n \\ B survives with probability q^{-m}, yielding expected spurious count (q^n - q^d) q^{-m}; and (3) for m >= n - d (Delta_m = m - (n - d)), full recovery succeeds with probability prod_{i=1}^{n-d} (1 - q^{-(Delta_m + i)})."
  },
  "theorems": [
    {
      "id": "T1",
      "name": "Deterministic Rank-Cardinality Law and Recovery Criterion",
      "statement": "For any m-tuple U_perp = (u^(1), ..., u^(m)) in (B^perp)^m of rank r_perp = dim(span(U_perp)), the orthogonal intersection subspace B_hat_m(U_perp) contains B, has cardinality q^(n - r_perp), and equals B if and only if r_perp = n - d."
    },
    {
      "id": "T2",
      "name": "Exact Exponential Decay of Expected Spurious Survivors",
      "statement": "Under m i.i.d. uniform dual samples U_perp ~ Unif((B^perp)^m), every non-planted vector x in F_q^n \\ B survives in B_hat_m(U_perp) with probability q^(-m), so E[|B_hat_m(U_perp)|] = q^d + (q^n - q^d) q^(-m) and E[|B_hat_m(U_perp) \\ B|] = (q^n - q^d) q^(-m)."
    },
    {
      "id": "T3",
      "name": "Exact Full-Recovery Probability Law and Two-Sided Oversampling Bounds",
      "statement": "For m >= n - d with oversampling margin Delta_m = m - (n - d) >= 0, P_recover(q, n - d, m) = Pr[B_hat_m(U_perp) = B] = prod_(i=1)^(n-d) (1 - q^(-(Delta_m + i))), satisfying 1 - sum_(i=1)^(n-d) q^(-(Delta_m + i)) <= P_recover <= 1 - q^(-(Delta_m + 1))."
    }
  ],
  "title": "Planted q-ary Dual-Intersection Cascade Bridge: Exact Candidate Subspace Size Law, Spurious Survivor Decay, and Oversampling Recovery Probability"
}
