  "summary_of_theorems": {
    "T1_centered_rref_sparsity_and_addition_count": "nnz(B) = n + nnz(C) <= n + m*(n - m), and total CDKM constant additions (with uncompute) equal N_add = 2 * (b * nnz(B) + (1 + nnz(C_{*, j_0})) + n).",
    "T2_modulus_independent_free_column_cell_widths": "Every non-split free column F_j has point bound (M_box - 1) + W and the split free column F_{j_0} has point bound p_split*(M_box - 1) + g_res + W, both independent of q and n.",
    "T3_closed_form_nonsplit_free_column_popcount": "Every non-split free column F_j contributes adds(F_j) = b + 1 and popcount_sum(F_j) = b + w - popcount(offsets_{F_j} - 1)."
  },
