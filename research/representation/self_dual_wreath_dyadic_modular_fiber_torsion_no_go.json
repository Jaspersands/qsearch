  "theorem_contract": {
    "density_bound": "The roots-of-unity filter gives ||U|/2^u-1/m| <= ((m-1)/m)cos(pi/m)^u.",
    "dyadic_consequence": "For fixed m=2^r, true limiting scalar margin is r-1+1/m>0.",
    "fiber": "U_(m,u)={v in F_2^u: HammingWeight(v)=0 mod m}.",
    "presentation_isomorphism": "For u>=m+1, adjacent m-subset relations identify all x_i and an m-subset gives x^m=1; every other relation follows. Thus P(U)=C_m.",
    "scope": "This kills cyclic Hamming-mod-m automata only. Nonabelian dyadic fibers, growing m, and interleaved leaves are not covered.",
    "symmetric_group_torsion_exponent": "The cycle index for permutations with cycle lengths dividing m gives #Hom(C_m,S_n)=|S_n|^(1-1/m+o(1))."
