    "asymptotic_scale": "Aggarwal--Elboim implies C_n,D_n=exp(-Theta(sqrt(n))); for k=Theta(n log n), TV=exp(-Theta(sqrt(n))).",
    "conditioning_tv_identity": "TV(Law(.|pairwise unequal),Law(.|globally distinct))=1-P_cf/(1-C_n)^k.",
    "cross_collision_bounds": "D_n<=TV<=(binom(2k,2)-k)D_n, where D_n=sum_lambda[p_lambda(1-p_lambda)/(1-C_n)]^2.",
    "global_distinct_joint_kernel": "Expand every unequal character or projector-word factor into rank-one source features and divide the resulting injective transform by P_cf=(2k)!e_(2k)(p).",
    "injective_transform": "I_n(f_1,...,f_r)=sum_distinct(nu_1,...,nu_r) prod_j p_(nu_j)f_j(nu_j), computed by subset DP.",
