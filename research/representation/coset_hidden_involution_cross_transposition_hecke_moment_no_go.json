    "baseline_second_moment": "tr_B(X^2)=1/[2^k m(m-1)]",
    "baseline_third_moment": "tr_B(X^3)=1/[4^k m^2(m-1)^2]",
    "binary_return_classification": "c(r)=1+1[r in C(h) intersect tC(h)t] for every m>=3",
    "common_centralizer": "|C(h) intersect tC(h)t|=2^m(m-2)!, index m(m-1) in C(h)",
    "cubic_return_classification": "For r=m(m-1), a=3m^2-7m+5, binary return counts 1,2,4 occur on (r^2-a-1)|J|^2, a|J|^2, |J|^2 shared paths.",
    "degree_four_support_classification": "For n=m-2, N8=1, N4=7+16n+14*C(n,2), and N2=84n+260*C(n,2)+336*C(n,3)+144*C(n,4), with N1=r^3-N2-N4-N8. This holds for m=3 and m>=5; at m=4 exactly six paths move from N1 to N2.",
