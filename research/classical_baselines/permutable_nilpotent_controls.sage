"""Exact scope falsifiers using exposed subgroups; NOT an oracle algorithm."""
from sage.libs.gap.libgap import libgap

def subgroups(G):
    return [H for cl in libgap.ConjugacyClassesSubgroups(G) for H in cl.Elements()]

def permutes(H, K):
    return int(libgap.Size(libgap.ClosureGroup(H,K))) * int(libgap.Size(libgap.Intersection(H,K))) == int(H.Size()) * int(K.Size())

def z2(G):
    Z = libgap.Centre(G)
    pi = libgap.NaturalHomomorphismByNormalSubgroup(G,Z)
    return libgap.PreImage(pi, libgap.Centre(libgap.Image(pi)))

# A legal refined chain yields a nonnormal first answer even when H=G.
D = libgap.DihedralGroup(8)
r = next(x for x in D.Elements() if int(x.Order()) == 4)
R = libgap.Subgroup(D,[r])
s = next(x for x in D.Elements() if int(x.Order()) == 2 and not bool(x in R))
B = libgap.Subgroup(D,[s])
V = libgap.Subgroup(D,[r**2,s])
chain = [D,V,B,libgap.TrivialSubgroup(D)]
for P,Q in zip(chain[:-1],chain[1:]):
    assert bool(libgap.IsNormal(P,Q)) and int(P.Size()) == 2*int(Q.Size())
assert z2(B) == B
assert not bool(libgap.IsNormal(D,B))
S = libgap.Normalizer(D,B)
assert S == V and int(S.Size()) == 4
pi = libgap.NaturalHomomorphismByNormalSubgroup(S,B)
assert libgap.PreImage(pi,z2(libgap.Image(pi))) == V
assert libgap.Normalizer(D,V) == D
assert libgap.Normalizer(V,V) == V
print('PASS: D8 original normalizers grow 2 -> 4 -> 8; permanently retaining V4 loses H=G.')

# A cyclic order-p H without permutability need not lie in Z2.
D16 = libgap.DihedralGroup(16)
r16 = next(x for x in D16.Elements() if int(x.Order()) == 8)
R16 = libgap.Subgroup(D16,[r16])
s16 = next(x for x in D16.Elements() if int(x.Order()) == 2 and not bool(x in R16))
J = libgap.Subgroup(D16,[s16])
assert int(z2(D16).Size()) == 4
assert int(libgap.Intersection(J,z2(D16)).Size()) == 1
assert any(not permutes(J,K) for K in subgroups(D16))
print('PASS: D16 reflection is outside Z2 and fails permutability.')

# Mixed primes require the nilpotent Sylow split, not the p-group lemma.
S3 = libgap.SymmetricGroup(3)
A3 = libgap.DerivedSubgroup(S3)
assert int(A3.Size()) == 3 and bool(libgap.IsNormal(S3,A3))
assert all(permutes(A3,K) for K in subgroups(S3))
assert int(z2(S3).Size()) == 1
print('PASS: normal/permutable A3 in S3 is not in Z2; ambient p-group hypothesis is essential.')

# Retain a genuinely nonnormal permutable subgroup in the positive control.
M = libgap.SmallGroup(27,4)
msubs = subgroups(M)
HM = next(J for J in msubs if int(J.Size()) == 3 and not bool(libgap.IsNormal(M,J))
          and all(permutes(J,K) for K in msubs))
assert bool(libgap.IsSubgroup(z2(M),HM))
G = libgap.DirectProduct(M,D)
e1,e2 = libgap.Embedding(G,1), libgap.Embedding(G,2)
P3,P2 = libgap.Image(e1),libgap.Image(e2)
HM_image = libgap.Subgroup(G,[libgap.Image(e1,x) for x in HM.GeneratorsOfGroup()])
H = libgap.ClosureGroup(HM_image,P2)
assert int(G.Size()) == 216 and int(H.Size()) == 24
assert not bool(libgap.IsNormal(G,H))
assert libgap.Intersection(H,P3) == HM_image
assert libgap.Intersection(H,P2) == P2
assert libgap.ClosureGroup(libgap.Intersection(H,P3),libgap.Intersection(H,P2)) == H
# H is the inverse image of HM under the projection G -> M; HM permutable.
proj = libgap.Projection(G,1)
assert libgap.PreImage(proj,HM) == H
print('PASS: nonnormal permutable H in M27 x D8 recombines exactly from its Sylow intersections.')

# The general Sylow reduction must reject unmatched nonpermutable reflections.
reflections = [libgap.Subgroup(S3,[x]) for x in S3.Elements() if int(x.Order()) == 2]
H_bad,P_bad = reflections[0],reflections[1]
assert int(libgap.Intersection(H_bad,P_bad).Size()) == 1
assert not permutes(H_bad,P_bad)
print('PASS: distinct S3 reflections reject Sylow completeness without permutability.')

# Valid nonnilpotent H: chosen full Sylows generate, but do not commute.
Gmix = libgap.DirectProduct(M,S3)
a1,a2 = libgap.Embedding(Gmix,1),libgap.Embedding(Gmix,2)
HM_mix = libgap.Subgroup(Gmix,[libgap.Image(a1,x) for x in HM.GeneratorsOfGroup()])
Hmix = libgap.ClosureGroup(HM_mix,libgap.Image(a2))
assert libgap.PreImage(libgap.Projection(Gmix,1),HM) == Hmix
assert not bool(libgap.IsNormal(Gmix,Hmix)) and not bool(Hmix.IsNilpotentGroup())
Pmix2,Pmix3 = libgap.SylowSubgroup(Gmix,2),libgap.SylowSubgroup(Gmix,3)
Hmix2,Hmix3 = libgap.Intersection(Hmix,Pmix2),libgap.Intersection(Hmix,Pmix3)
assert (int(Hmix2.Size()),int(Hmix3.Size()),int(Hmix.Size())) == (2,9,18)
assert libgap.ClosureGroup(Hmix2,Hmix3) == Hmix
assert any(x*y != y*x for x in Hmix2.GeneratorsOfGroup() for y in Hmix3.GeneratorsOfGroup())
print('PASS: nonnormal, nonnilpotent H in M27 x S3 is generated by noncommuting Sylow pieces of orders2,9.')
