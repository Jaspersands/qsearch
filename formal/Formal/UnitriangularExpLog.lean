import Mathlib

/-!
# Truncated exponential and logarithm on a nil algebra of exponent `p`

Source: `research/audits/reviews/2026-11-08-rees-blackbox-corollary-draft.tex`, the item
*Unitriangular matrix groups* of the black-box input model: if the non-unital algebra
`A` generated by the `gᵢ - I` satisfies `A^p = 0`, then `(I + N)^p = I`, and the
truncated series

* `exp N = ∑_{k<p} N^k / k!` and
* `log (I + N) = ∑_{1 ≤ k < p} (-1)^(k+1) N^k / k`

are inverse bijections between `A` and `I + A`, with denominators prime to `p`.

Here everything is over `ZMod p` (`p` prime), so the denominators are honest inverses of
`k!` and `k` for `k < p` (`factorial_ne_zero`, `natCast_ne_zero`). The two polynomial
congruences `exp (log (1 + X)) ≡ 1 + X` and `log (exp X - 1) ≡ X` modulo `X^p`
(`exp_log_congr`, `log_exp_congr`) are proved in `(ZMod p)[X]` by the derivative
(ODE) argument: `exp' ≡ exp` and `(1 + X) log' ≡ 1` modulo `X^(p-1)`, the chain rule,
and uniqueness of solutions of the two first-order recurrences with prescribed constant
term (`dvd_of_ode`, `dvd_of_deriv`, `dvd_of_mul_dvd`). They are then evaluated at any
`N` with `N^p = 0` in any (possibly noncommutative) `ZMod p`-algebra (`texp_tlog`,
`tlog_texp`, `one_add_pow`).

For a non-unital subalgebra `A` in which every element has `p`-th power zero:
`expEquiv` is the bijection `A ≃ {g // g - 1 ∈ A}`; `unipotent` is the group
`{u | u - 1 ∈ A}` of units, every element of which has `u^p = 1`, and the group
generated by any units `gᵢ` with `gᵢ - 1 ∈ A` lies in it (`closure_le_unipotent`).
`strictUpper` is the algebra of strictly upper triangular `n × n` matrices; every
product of `n` of them vanishes (`strictUpper_prod_eq_zero`), so `A^p = 0` holds for
every subalgebra of it when `n ≤ p` (`strictUpper_pow_vanish`).

Not formalized here: the BCH identity `exp X exp Y = exp BCH(X, Y)`, the identification
of `log G` with the Lazard Lie ring, the class bound, and the polynomial-time linear
algebra of the draft.
-/

namespace QSearch.UnitriangularExpLog

open Polynomial

section Poly

variable (p : ℕ) [hp : Fact p.Prime]

/-- The truncated exponential `∑_{k<p} X^k / k!` over `ZMod p`. -/
noncomputable def expPoly : (ZMod p)[X] :=
  ∑ k ∈ Finset.range p, C ((k.factorial : ZMod p)⁻¹) * X ^ k

/-- The truncated logarithm of `1 + X`, `∑_{1≤k<p} (-1)^(k+1) X^k / k` over `ZMod p`
(the `k = 0` term is `0`, since `0⁻¹ = 0`). -/
noncomputable def logPoly : (ZMod p)[X] :=
  ∑ k ∈ Finset.range p, C ((-1) ^ (k + 1) * (k : ZMod p)⁻¹) * X ^ k

variable {p}

theorem natCast_ne_zero {k : ℕ} (hk0 : 0 < k) (hkp : k < p) : (k : ZMod p) ≠ 0 :=
  (ZMod.natCast_eq_zero_iff k p).not.mpr (Nat.not_dvd_of_pos_of_lt hk0 hkp)

theorem factorial_ne_zero {k : ℕ} (hkp : k < p) : (k.factorial : ZMod p) ≠ 0 :=
  (ZMod.natCast_eq_zero_iff _ p).not.mpr fun h =>
    absurd ((Nat.Prime.dvd_factorial hp.out).mp h) (by omega)

theorem coeff_expPoly (n : ℕ) :
    (expPoly p).coeff n = if n < p then ((n.factorial : ZMod p))⁻¹ else 0 := by
  rw [expPoly, finsetSum_coeff]
  simp only [coeff_C_mul_X_pow, Finset.sum_ite_eq, Finset.mem_range]

theorem coeff_logPoly (n : ℕ) :
    (logPoly p).coeff n = if n < p then (-1) ^ (n + 1) * (n : ZMod p)⁻¹ else 0 := by
  rw [logPoly, finsetSum_coeff]
  simp only [coeff_C_mul_X_pow, Finset.sum_ite_eq, Finset.mem_range]

/-- The coefficients really are the inverses of `k!` and `k`. -/
theorem factorial_mul_coeff_expPoly {k : ℕ} (hk : k < p) :
    (k.factorial : ZMod p) * (expPoly p).coeff k = 1 := by
  rw [coeff_expPoly, ite_eq_left hk, mul_inv_cancel₀ (factorial_ne_zero hk)]

theorem mul_coeff_logPoly {k : ℕ} (hk0 : 0 < k) (hk : k < p) :
    (k : ZMod p) * (logPoly p).coeff k = (-1) ^ (k + 1) := by
  rw [coeff_logPoly, ite_eq_left hk, mul_comm, mul_assoc, inv_mul_cancel₀ (natCast_ne_zero hk0 hk),
    mul_one]

theorem coeff_expPoly_zero : (expPoly p).coeff 0 = 1 := by
  rw [coeff_expPoly, ite_eq_left hp.out.pos]; simp

theorem coeff_logPoly_zero : (logPoly p).coeff 0 = 0 := by
  rw [coeff_logPoly]; simp

/-- `exp' ≡ exp` modulo `X^(p-1)`. -/
theorem expPoly_deriv : X ^ (p - 1) ∣ derivative (expPoly p) - expPoly p := by
  rw [X_pow_dvd_iff]
  intro d hd
  have h1 : d + 1 < p := by omega
  rw [coeff_sub, coeff_derivative, coeff_expPoly, coeff_expPoly, ite_eq_left h1,
    ite_eq_left (by omega), Nat.factorial_succ, Nat.cast_mul, mul_inv_rev]
  have hd1 : ((d + 1 : ℕ) : ZMod p) ≠ 0 := natCast_ne_zero (by omega) h1
  rw [Nat.cast_add_one] at hd1 ⊢
  rw [inv_mul_cancel_right₀ hd1, sub_self]

/-- `(1 + X) log' ≡ 1` modulo `X^(p-1)`. -/
theorem logPoly_deriv : X ^ (p - 1) ∣ (1 + X) * derivative (logPoly p) - 1 := by
  rw [X_pow_dvd_iff]
  intro d hd
  rw [coeff_sub, add_mul, one_mul, coeff_add, coeff_one]
  rcases d with _ | e
  · rw [coeff_X_mul_zero, coeff_derivative, coeff_logPoly, ite_eq_left (by omega)]
    simp
  · have h2 : e + 2 < p := by omega
    rw [coeff_X_mul, coeff_derivative, coeff_derivative, coeff_logPoly, coeff_logPoly,
      ite_eq_left h2, ite_eq_left (by omega)]
    have he1 : ((e + 1 : ℕ) : ZMod p) ≠ 0 := natCast_ne_zero (by omega) (by omega)
    have he2 : ((e + 1 + 1 : ℕ) : ZMod p) ≠ 0 := natCast_ne_zero (by omega) h2
    push_cast at he1 he2 ⊢
    rw [mul_assoc, inv_mul_cancel₀ he2, mul_assoc, inv_mul_cancel₀ he1]
    simp [pow_succ]

/-- Composition with a series without constant term respects congruences mod `X^n`. -/
theorem dvd_sub_comp {P Q T : (ZMod p)[X]} {n : ℕ} (hT : X ∣ T) (h : X ^ n ∣ P - Q) :
    X ^ n ∣ P.comp T - Q.comp T := by
  obtain ⟨S, hS⟩ := h
  rw [← sub_comp, hS, mul_comp, X_pow_comp]
  exact dvd_mul_of_dvd_left (pow_dvd_pow_of_dvd hT n) _

/-- Uniqueness for `(1 + X) H' ≡ H` with `H(0) = 0`. -/
theorem dvd_of_ode {H : (ZMod p)[X]} (h0 : H.coeff 0 = 0)
    (h : X ^ (p - 1) ∣ (1 + X) * derivative H - H) : X ^ p ∣ H := by
  rw [X_pow_dvd_iff] at h ⊢
  intro d
  induction d with
  | zero => intro _; exact h0
  | succ d ih =>
    intro hd
    have ihd := ih (by omega)
    have hc := h d (by omega)
    rw [coeff_sub, add_mul, one_mul, coeff_add, coeff_derivative, ihd, sub_zero] at hc
    have hx : (X * derivative H).coeff d = 0 := by
      rcases d with _ | e
      · exact coeff_X_mul_zero _
      · rw [coeff_X_mul, coeff_derivative, ihd, zero_mul]
    rw [hx, add_zero] at hc
    have hd1 : ((d + 1 : ℕ) : ZMod p) ≠ 0 := natCast_ne_zero (by omega) hd
    push_cast at hd1
    exact (mul_eq_zero.mp hc).resolve_right hd1

/-- Uniqueness for `G' ≡ 1` with `G(0) = 0`. -/
theorem dvd_of_deriv {G : (ZMod p)[X]} (h0 : G.coeff 0 = 0)
    (h : X ^ (p - 1) ∣ derivative G - 1) : X ^ p ∣ G - X := by
  rw [X_pow_dvd_iff] at h ⊢
  intro d hd
  rcases d with _ | e
  · simp [h0]
  · have hc := h e (by omega)
    rw [coeff_sub, coeff_derivative, coeff_one] at hc
    have he1 : ((e + 1 : ℕ) : ZMod p) ≠ 0 := natCast_ne_zero (by omega) hd
    push_cast at he1
    rw [coeff_sub, coeff_X]
    rcases e with _ | f
    · simp at hc ⊢; exact hc
    · simp only [Nat.add_eq_zero_iff, one_ne_zero, and_false, ite_false, sub_zero] at hc
      have : G.coeff (f + 1 + 1) = 0 := (mul_eq_zero.mp hc).resolve_right he1
      simp [this]

/-- Cancellation of a factor with constant term one modulo `X^n`. -/
theorem dvd_of_mul_dvd {E Q : (ZMod p)[X]} (hE : E.coeff 0 = 1) :
    ∀ n : ℕ, X ^ n ∣ E * Q → X ^ n ∣ Q := by
  intro n
  induction n generalizing Q with
  | zero => intro _; simp
  | succ n ih =>
    intro h
    obtain ⟨Q1, hQ1⟩ := ih (dvd_trans (pow_dvd_pow X (Nat.le_succ n)) h)
    subst hQ1
    have h' : X ^ n * X ∣ X ^ n * (E * Q1) := by
      rw [← pow_succ, show X ^ n * (E * Q1) = E * (X ^ n * Q1) by ring]; exact h
    have hX : X ∣ E * Q1 := (mul_dvd_mul_iff_left (pow_ne_zero n X_ne_zero)).mp h'
    rw [X_dvd_iff, mul_coeff_zero, hE, one_mul] at hX
    rw [pow_succ]
    exact mul_dvd_mul_left _ (X_dvd_iff.mpr hX)

/-- `exp (log (1 + X)) ≡ 1 + X` modulo `X^p`. -/
theorem exp_log_congr : X ^ p ∣ (expPoly p).comp (logPoly p) - (1 + X) := by
  have hL : X ∣ logPoly p := X_dvd_iff.mpr coeff_logPoly_zero
  apply dvd_of_ode
  · rw [coeff_sub, coeff_zero_eq_eval_zero, eval_comp, ← coeff_zero_eq_eval_zero,
      coeff_logPoly_zero, ← coeff_zero_eq_eval_zero, coeff_expPoly_zero]
    simp
  · have hd : derivative ((expPoly p).comp (logPoly p) - (1 + X)) =
        derivative (logPoly p) * (derivative (expPoly p)).comp (logPoly p) - 1 := by
      rw [derivative_sub, derivative_comp, derivative_add, derivative_one, derivative_X,
        zero_add]
    rw [hd]
    have e : (1 + X) * (derivative (logPoly p) * (derivative (expPoly p)).comp (logPoly p) - 1)
        - ((expPoly p).comp (logPoly p) - (1 + X)) =
        ((1 + X) * derivative (logPoly p) - 1) * (derivative (expPoly p)).comp (logPoly p) +
        ((derivative (expPoly p)).comp (logPoly p) - (expPoly p).comp (logPoly p)) := by ring
    rw [e]
    exact dvd_add (dvd_mul_of_dvd_left logPoly_deriv _) (dvd_sub_comp hL expPoly_deriv)

/-- `log (exp X) ≡ X` modulo `X^p`, i.e. `log (1 + (exp X - 1)) ≡ X`. -/
theorem log_exp_congr : X ^ p ∣ (logPoly p).comp (expPoly p - 1) - X := by
  have hT : X ∣ expPoly p - 1 := by
    rw [X_dvd_iff, coeff_sub, coeff_expPoly_zero, coeff_one_zero, sub_self]
  apply dvd_of_deriv
  · rw [coeff_zero_eq_eval_zero, eval_comp, ← coeff_zero_eq_eval_zero (expPoly p - 1),
      (X_dvd_iff.mp hT), ← coeff_zero_eq_eval_zero, coeff_logPoly_zero]
  · -- `E · (G' - 1) = E' · (E · L'(T) - 1) + (E' - E)`, both terms `≡ 0`.
    have hcomp : X ^ (p - 1) ∣ expPoly p * (derivative (logPoly p)).comp (expPoly p - 1) - 1 := by
      have := dvd_sub_comp hT (logPoly_deriv (p := p))
      simpa [mul_comp, add_comp] using this
    apply dvd_of_mul_dvd coeff_expPoly_zero
    have hd : derivative ((logPoly p).comp (expPoly p - 1)) =
        derivative (expPoly p) * (derivative (logPoly p)).comp (expPoly p - 1) := by
      rw [derivative_comp, derivative_sub, derivative_one, sub_zero]
    rw [hd]
    have e : expPoly p * (derivative (expPoly p) *
        (derivative (logPoly p)).comp (expPoly p - 1) - 1) =
        derivative (expPoly p) *
          (expPoly p * (derivative (logPoly p)).comp (expPoly p - 1) - 1) +
        (derivative (expPoly p) - expPoly p) := by ring
    rw [e]
    exact dvd_add (dvd_mul_of_dvd_right hcomp _) expPoly_deriv

/-- `(1 + X)^p = 1 + X^p` in characteristic `p`. -/
theorem one_add_X_pow : (1 + X : (ZMod p)[X]) ^ p = 1 + X ^ p := by
  rw [add_pow_char, one_pow]

end Poly

section Algebra

variable {p : ℕ} [hp : Fact p.Prime] {R : Type*} [Ring R] [Algebra (ZMod p) R]

variable (p) in
/-- The truncated exponential in a `ZMod p`-algebra. -/
noncomputable def texp (x : R) : R := aeval x (expPoly p)

variable (p) in
/-- The truncated logarithm: `tlog N` is `log (1 + N)`. -/
noncomputable def tlog (x : R) : R := aeval x (logPoly p)

theorem one_add_pow {N : R} (hN : N ^ p = 0) : (1 + N) ^ p = 1 := by
  have h := congrArg (aeval N) (one_add_X_pow (p := p))
  simpa [hN] using h

theorem texp_tlog {N : R} (hN : N ^ p = 0) : texp p (tlog p N) = 1 + N := by
  obtain ⟨Q, hQ⟩ := exp_log_congr (p := p)
  have h := congrArg (aeval N) hQ
  rw [map_sub, aeval_comp, map_mul, map_pow, aeval_X, hN, zero_mul, sub_eq_zero, map_add,
    map_one, aeval_X] at h
  exact h

theorem tlog_texp {N : R} (hN : N ^ p = 0) : tlog p (texp p N - 1) = N := by
  obtain ⟨Q, hQ⟩ := log_exp_congr (p := p)
  have h := congrArg (aeval N) hQ
  rw [map_sub, aeval_comp, map_mul, map_pow, aeval_X, hN, zero_mul, sub_eq_zero, map_sub,
    map_one] at h
  exact h

theorem pow_succ_mem (A : NonUnitalSubalgebra (ZMod p) R) {N : R} (hN : N ∈ A) :
    ∀ k : ℕ, N ^ (k + 1) ∈ A
  | 0 => by simpa using hN
  | k + 1 => by rw [pow_succ]; exact mul_mem (pow_succ_mem A hN k) hN

/-- A polynomial without constant term, evaluated in a non-unital subalgebra, stays in it. -/
theorem aeval_mem (A : NonUnitalSubalgebra (ZMod p) R) {N : R} (hN : N ∈ A)
    (P : (ZMod p)[X]) (hP : P.coeff 0 = 0) : aeval N P ∈ A := by
  rw [aeval_eq_sum_range]
  refine sum_mem fun k _ => ?_
  rcases k with _ | k
  · rw [hP, zero_smul]; exact zero_mem A
  · exact SMulMemClass.smul_mem _ (pow_succ_mem A hN k)

variable (A : NonUnitalSubalgebra (ZMod p) R)

theorem tlog_mem {N : R} (hN : N ∈ A) : tlog p N ∈ A :=
  aeval_mem A hN _ coeff_logPoly_zero

theorem texp_sub_one_mem {N : R} (hN : N ∈ A) : texp p N - 1 ∈ A := by
  have h := aeval_mem A hN (expPoly p - 1) (by rw [coeff_sub, coeff_expPoly_zero,
    coeff_one_zero, sub_self])
  rwa [map_sub, map_one] at h

/-- **The truncated exponential is a bijection `A ≃ I + A`, with inverse the truncated
logarithm**, whenever every element of `A` has `p`-th power zero. -/
noncomputable def expEquiv (hA : ∀ N ∈ A, N ^ p = 0) : A ≃ {g : R // g - 1 ∈ A} where
  toFun N := ⟨texp p (N : R), texp_sub_one_mem A N.2⟩
  invFun g := ⟨tlog p ((g : R) - 1), tlog_mem A g.2⟩
  left_inv N := Subtype.ext (tlog_texp (hA _ N.2))
  right_inv g := Subtype.ext (by
    change texp p (tlog p ((g : R) - 1)) = g
    rw [texp_tlog (hA _ g.2)]; abel)

theorem expEquiv_apply (hA : ∀ N ∈ A, N ^ p = 0) (N : A) :
    (expEquiv A hA N : R) = texp p (N : R) := rfl

theorem expEquiv_symm_apply (hA : ∀ N ∈ A, N ^ p = 0) (g : {g : R // g - 1 ∈ A}) :
    ((expEquiv A hA).symm g : R) = tlog p ((g : R) - 1) := rfl

theorem one_add_mul_mem {a b : R} (ha : a - 1 ∈ A) (hb : b - 1 ∈ A) : a * b - 1 ∈ A := by
  have h : a * b - 1 = (a - 1) + (b - 1) + (a - 1) * (b - 1) := by noncomm_ring
  rw [h]
  exact A.add_mem (A.add_mem ha hb) (A.mul_mem ha hb)

/-- The unipotent group `{u | u - 1 ∈ A}` of units. -/
def unipotent (hA : ∀ N ∈ A, N ^ p = 0) : Subgroup Rˣ where
  carrier := {u | (u : R) - 1 ∈ A}
  one_mem' := by simp
  mul_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq, Units.val_mul] at ha hb ⊢
    exact one_add_mul_mem A ha hb
  inv_mem' {u} hu := by
    simp only [Set.mem_ofPred_eq] at hu ⊢
    have hpow : (u : R) ^ p = 1 := by
      have := one_add_pow (hA _ hu)
      rwa [add_sub_cancel] at this
    have hp1 : 1 ≤ p := hp.out.one_lt.le
    have hinv : ((u⁻¹ : Rˣ) : R) = (u : R) ^ (p - 1) := by
      have h1 : (u : R) * (u : R) ^ (p - 1) = 1 := by
        rw [← pow_succ', Nat.sub_add_cancel hp1, hpow]
      calc ((u⁻¹ : Rˣ) : R) = ((u⁻¹ : Rˣ) : R) * ((u : R) * (u : R) ^ (p - 1)) := by
            rw [h1, mul_one]
        _ = (u : R) ^ (p - 1) := by rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [hinv]
    clear hinv hpow
    induction p - 1 with
    | zero => simp
    | succ k ih => rw [pow_succ]; exact one_add_mul_mem A ih hu

theorem mem_unipotent (hA : ∀ N ∈ A, N ^ p = 0) (u : Rˣ) :
    u ∈ unipotent A hA ↔ (u : R) - 1 ∈ A := Iff.rfl

/-- Every element of the unipotent group has order dividing `p`. -/
theorem pow_eq_one (hA : ∀ N ∈ A, N ^ p = 0) {u : Rˣ} (hu : u ∈ unipotent A hA) :
    u ^ p = 1 := by
  apply Units.ext
  have := one_add_pow (hA _ hu)
  rwa [add_sub_cancel, ← Units.val_pow_eq_pow_val] at this

/-- The group generated by units `gᵢ` with `gᵢ - 1 ∈ A` lies in `I + A`. -/
theorem closure_le_unipotent (hA : ∀ N ∈ A, N ^ p = 0) (S : Set Rˣ)
    (hS : ∀ g ∈ S, (g : R) - 1 ∈ A) : Subgroup.closure S ≤ unipotent A hA :=
  (Subgroup.closure_le _).mpr hS

/-- `A^p = 0` (every product of `p` elements vanishes) implies `N^p = 0` on `A`. -/
theorem pow_eq_zero_of_prod (hA : ∀ l : List R, l.length = p → (∀ a ∈ l, a ∈ A) → l.prod = 0)
    {N : R} (hN : N ∈ A) : N ^ p = 0 := by
  have h := hA (List.replicate p N) (List.length_replicate ..) (fun a ha => by
    rw [List.eq_of_mem_replicate ha]; exact hN)
  rwa [List.prod_replicate] at h

/-- **The draft's matrix-group condition, general form.** Let `A` be a non-unital
`ZMod p`-subalgebra of `R` with `A^p = 0` (every product of `p` elements of `A` vanishes),
and let units `gᵢ` satisfy `gᵢ - 1 ∈ A` (for instance, `A` is the subalgebra generated by
the `gᵢ - 1`). Then every `u` in the group generated by the `gᵢ` has `u - 1 ∈ A` and
`u ^ p = 1`, and the truncated `exp` and `log` are inverse bijections between `A` and
`1 + A`. -/
theorem matrix_group_condition {ι : Type*} (g : ι → Rˣ) (hg : ∀ i, (g i : R) - 1 ∈ A)
    (hA : ∀ l : List R, l.length = p → (∀ a ∈ l, a ∈ A) → l.prod = 0) :
    (∀ u ∈ Subgroup.closure (Set.range g), (u : R) - 1 ∈ A ∧ u ^ p = 1) ∧
    (∀ N ∈ A, texp p N - 1 ∈ A ∧ tlog p (texp p N - 1) = N) ∧
    (∀ x : R, x - 1 ∈ A → tlog p (x - 1) ∈ A ∧ texp p (tlog p (x - 1)) = x) := by
  have hA' : ∀ N ∈ A, N ^ p = 0 := fun N hN => pow_eq_zero_of_prod A hA hN
  refine ⟨fun u hu => ?_, fun N hN => ⟨texp_sub_one_mem A hN, tlog_texp (hA' N hN)⟩,
    fun x hx => ⟨tlog_mem A hx, ?_⟩⟩
  · have hu' : u ∈ unipotent A hA' :=
      closure_le_unipotent A hA' (Set.range g) (by rintro _ ⟨i, rfl⟩; exact hg i) hu
    exact ⟨(mem_unipotent A hA' u).mp hu', pow_eq_one A hA' hu'⟩
  · rw [texp_tlog (hA' _ hx)]; abel

end Algebra

section Triangular

variable {S : Type*} [CommRing S] {n : ℕ}

/-- Strictly upper triangular `n × n` matrices, as a non-unital subalgebra. -/
def strictUpper (S : Type*) [CommRing S] (n : ℕ) :
    NonUnitalSubalgebra S (Matrix (Fin n) (Fin n) S) where
  carrier := {M | ∀ i j, j ≤ i → M i j = 0}
  add_mem' {M N} hM hN i j hij := by simp [hM i j hij, hN i j hij]
  zero_mem' i j _ := rfl
  mul_mem' {M N} hM hN i j hij := by
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun k _ => ?_
    by_cases hk : k ≤ i
    · rw [hM i k hk, zero_mul]
    · rw [hN k j (le_trans hij (le_of_lt (not_le.mp hk))), mul_zero]
  smul_mem' c {M} hM i j hij := by simp [hM i j hij]

theorem mem_strictUpper (M : Matrix (Fin n) (Fin n) S) :
    M ∈ strictUpper S n ↔ ∀ i j, j ≤ i → M i j = 0 := Iff.rfl

/-- A product of `m` strictly upper triangular matrices vanishes below the `m`-th
superdiagonal. -/
theorem strictUpper_list_prod (l : List (Matrix (Fin n) (Fin n) S))
    (hl : ∀ M ∈ l, M ∈ strictUpper S n) (i j : Fin n) (hij : (j : ℕ) < i + l.length) :
    l.prod i j = 0 := by
  induction l generalizing i with
  | nil =>
    simp only [List.length_nil, add_zero] at hij
    simp [(Fin.ne_of_lt hij).symm]
  | cons M l ih =>
    rw [List.prod_cons, Matrix.mul_apply]
    refine Finset.sum_eq_zero fun k _ => ?_
    by_cases hk : k ≤ i
    · rw [(hl M (List.mem_cons_self ..)) i k hk, zero_mul]
    · rw [ih (fun N hN => hl N (List.mem_cons_of_mem _ hN)) k (by
        simp only [List.length_cons] at hij
        have : (i : ℕ) < k := not_le.mp hk
        omega), mul_zero]

/-- Every product of `n` strictly upper triangular `n × n` matrices is zero. -/
theorem strictUpper_prod_eq_zero (l : List (Matrix (Fin n) (Fin n) S))
    (hl : ∀ M ∈ l, M ∈ strictUpper S n) (hlen : n ≤ l.length) : l.prod = 0 := by
  ext i j
  rw [strictUpper_list_prod l hl i j (by have := j.2; omega)]
  rfl

/-- So for `n ≤ p`, every subalgebra `A` of strictly upper triangular matrices over
`ZMod p` satisfies `A^p = 0`, and every element has `p`-th power zero. -/
theorem strictUpper_pow_vanish {p : ℕ} [Fact p.Prime] (hn : n ≤ p)
    (A : NonUnitalSubalgebra (ZMod p) (Matrix (Fin n) (Fin n) (ZMod p)))
    (hA : A ≤ strictUpper (ZMod p) n) :
    (∀ l : List (Matrix (Fin n) (Fin n) (ZMod p)), l.length = p → (∀ a ∈ l, a ∈ A) →
      l.prod = 0) ∧ ∀ N ∈ A, N ^ p = 0 := by
  have hprod : ∀ l : List (Matrix (Fin n) (Fin n) (ZMod p)), l.length = p →
      (∀ a ∈ l, a ∈ A) → l.prod = 0 := fun l hl hmem =>
    strictUpper_prod_eq_zero l (fun M hM => hA (hmem M hM)) (by omega)
  exact ⟨hprod, fun N hN => pow_eq_zero_of_prod A hprod hN⟩

/-- The non-unital algebra generated by the `gᵢ - 1` of unitriangular `gᵢ` is strictly
upper triangular. -/
theorem adjoin_le_strictUpper {ι : Type*} (g : ι → Matrix (Fin n) (Fin n) S)
    (hg : ∀ i, g i - 1 ∈ strictUpper S n) :
    NonUnitalAlgebra.adjoin S (Set.range fun i => g i - 1) ≤ strictUpper S n :=
  NonUnitalAlgebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact hg i)

/-- **The draft's matrix-group condition for `G ≤ UT_n(F_p)` with `n ≤ p`.** For
generators `gᵢ ∈ UT_n(F_p)`, the non-unital algebra `A` generated by the `gᵢ - I` satisfies
`A^p = 0`; the group `G` they generate lies in `I + A` and has exponent dividing `p`; and
the truncated `exp` and `log` are inverse bijections between `A` and `I + A`. -/
theorem unitriangular_condition {p : ℕ} [Fact p.Prime] (hn : n ≤ p) {ι : Type*}
    (g : ι → (Matrix (Fin n) (Fin n) (ZMod p))ˣ)
    (hg : ∀ i, (g i : Matrix (Fin n) (Fin n) (ZMod p)) - 1 ∈ strictUpper (ZMod p) n) :
    let A := NonUnitalAlgebra.adjoin (ZMod p)
      (Set.range fun i => (g i : Matrix (Fin n) (Fin n) (ZMod p)) - 1)
    (∀ l : List (Matrix (Fin n) (Fin n) (ZMod p)), l.length = p → (∀ a ∈ l, a ∈ A) →
      l.prod = 0) ∧
    (∀ u ∈ Subgroup.closure (Set.range g), (u : Matrix (Fin n) (Fin n) (ZMod p)) - 1 ∈ A ∧
      u ^ p = 1) ∧
    (∀ N ∈ A, texp p N - 1 ∈ A ∧ tlog p (texp p N - 1) = N) ∧
    (∀ x : Matrix (Fin n) (Fin n) (ZMod p), x - 1 ∈ A →
      tlog p (x - 1) ∈ A ∧ texp p (tlog p (x - 1)) = x) := by
  intro A
  have hprod := (strictUpper_pow_vanish hn A
    (adjoin_le_strictUpper (fun i => (g i : Matrix (Fin n) (Fin n) (ZMod p))) hg)).1
  exact ⟨hprod, matrix_group_condition A g
    (fun i => NonUnitalAlgebra.subset_adjoin (ZMod p) ⟨i, rfl⟩) hprod⟩

end Triangular

end QSearch.UnitriangularExpLog
