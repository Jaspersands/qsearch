  intro e he
  have h := List.all_eq_true.mp extCharsList_eq_python e he
  rw [beq_iff_eq] at h
  rw [← h, ofCoeffList_extCharsList]

/-- Coefficient form: Python's `chars[j]` is the `j`-th coefficient of `stdDet L`. -/
theorem stdDet_coeff_eq_python :
    ∀ e ∈ pythonValues, ∀ j : ℕ, (stdDet e.1).coeff j = e.2.getD j 0 := by
  intro e he j
  rw [stdDet_eq_python e he, coeff_ofCoeffList]

